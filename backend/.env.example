# --- Backend environment example ---
# Copy to backend/.env and adjust. Every value is optional for local dev:
#   * DATABASE_URL falls back to sqlite:///./secrets.db
#   * ENCRYPTION_KEY is generated into backend/.fernet.key when omitted

# DATABASE_URL=sqlite:///./secrets.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/secrets

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Optional: write the auto-generated key somewhere else.
# FERNET_KEY_FILE=./.fernet.key

# Comma-separated origins. Defaults to http://localhost:5173 and *.
# CORS_ORIGINS=http://localhost:5173
