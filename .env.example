# Copy to .env for Docker Compose. Both values are optional.

# A Fernet key. If omitted, the backend generates one in the /data volume.
# ENCRYPTION_KEY=

# Where the browser should reach the API (baked into the frontend build).
# VITE_API_URL=http://localhost:8000

# Comma-separated allowed browser origins.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
